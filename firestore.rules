rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección _admin_users (perfiles de directores y suscripciones)
    match /_admin_users/{uid} {
      // El dueño del perfil y el super-admin pueden leer su información de acceso
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == 'zlagustin10@gmail.com');
      // Cualquier director autenticado puede escribir únicamente su propio perfil de acceso
      allow write: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == 'zlagustin10@gmail.com');
    }

    // Reglas para el buzón / inbox público de cada escuela (Portal Docente)
    match /schools/{schoolId}/correos_recibidos/{docId} {
      // Permite que los docentes envíen correos sin autenticarse (crear documento)
      allow create: if true;
      // Solo el director de la escuela y el super-admin pueden leer, actualizar o borrar
      allow read, update, delete: if request.auth != null && (request.auth.uid == schoolId || request.auth.token.email == 'zlagustin10@gmail.com');
    }

    // Resto de la información de la escuela (Agenda, Repositorio, PEMC, CTE, Permisos)
    match /schools/{schoolId}/{document=**} {
      // Solo el director de la escuela correspondiente y el super-admin tienen acceso completo
      allow read, write: if request.auth != null && (request.auth.uid == schoolId || request.auth.token.email == 'zlagustin10@gmail.com');
    }
    
    // Regla de caída por defecto (fallback) para cualquier otra colección
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'zlagustin10@gmail.com';
    }
  }
}
