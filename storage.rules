rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Regla especial para subidas públicas de docentes (Portal Docente)
    match /schools/{schoolId}/public_uploads/{fileId} {
      // Docentes pueden subir archivos de hasta 20MB sin estar autenticados
      allow create: if request.resource.size < 20 * 1024 * 1024;
      // Solo el director de la escuela y el super-admin pueden leer o gestionar los archivos
      allow read, update, delete: if request.auth != null && (request.auth.uid == schoolId || request.auth.token.email == 'zlagustin10@gmail.com');
    }
    
    // Reglas aisladas para directores (logos, documentos, permisos privados)
    match /schools/{schoolId}/logos/{fileId} {
      allow read, write: if request.auth != null && (request.auth.uid == schoolId || request.auth.token.email == 'zlagustin10@gmail.com');
    }
    
    match /schools/{schoolId}/permisos/{fileId} {
      allow read, write: if request.auth != null && (request.auth.uid == schoolId || request.auth.token.email == 'zlagustin10@gmail.com');
    }
    
    match /schools/{schoolId}/documentos/{fileId} {
      allow read, write: if request.auth != null && (request.auth.uid == schoolId || request.auth.token.email == 'zlagustin10@gmail.com');
    }
    
    // Caída de seguridad por defecto para rutas fuera de schools/
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'zlagustin10@gmail.com';
    }
  }
}
