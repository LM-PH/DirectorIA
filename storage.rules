rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Regla base: Solo usuarios autenticados pueden leer o subir archivos
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 20 * 1024 * 1024; // Límite de 20MB opcional
    }
  }
}
